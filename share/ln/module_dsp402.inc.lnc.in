requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_dsp402_base
#     (optional) path to module_dsp402 base directory
#     e.g. /volume/software/robotkernel/packages/module_dsp402/3.0.1
#     defaults to rmpm structure
#   module_dsp402_libdir
#     (optional) add custom module search paths
#   module_dsp402_mds
#     (optional) add custom message definition paths

defines
module_dsp402_base: %(dirname %(dirname %(CURDIR)))
module_dsp402_libdir: %(subst "${exec_prefix}/", "", "@libdir@")
module_dsp402_type: %(ifexists "%(module_dsp402_base)/%(module_dsp402_libdir)/libmodule_dsp402.so", "local_install", "rmpm_release")
module_dsp402_library_path: %(ifeq "%(module_dsp402_type)", "local_install", "%(module_dsp402_base)/lib", "%(module_dsp402_base)/lib/$(ARCH)")

ifndef rk_library_path: rk_library_path: ""
rk_library_path: %(rk_library_path):%(module_dsp402_library_path)

